pipeline {
    agent any
    environment {
        // Use a safe Maven repository outside workspace
        MAVEN_REPO_LOCAL = "/var/jenkins_home/.m2"
    }
    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                script {
                    // Get Jenkins user UID and GID
                    def jenkinsUid = sh(script: "id -u", returnStdout: true).trim()
                    def jenkinsGid = sh(script: "id -g", returnStdout: true).trim()

                    // Run Maven inside Docker container as Jenkins user
                    docker.image('maven:3.8.8-eclipse-temurin-11').inside("-u ${jenkinsUid}:${jenkinsGid} -v /var/run/docker.sock:/var/run/docker.sock") {
                        withEnv(["MAVEN_OPTS=-Dmaven.repo.local=${env.MAVEN_REPO_LOCAL}"]) {
                            sh 'mvn clean install'
                        }
                    }
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                script {
                    docker.image('maven:3.8.8-eclipse-temurin-11').inside("-u ${jenkinsUid}:${jenkinsGid}") {
                        withEnv(["MAVEN_OPTS=-Dmaven.repo.local=${env.MAVEN_REPO_LOCAL}"]) {
                            sh 'mvn sonar:sonar'
                        }
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    def imageName = "your-dockerhub-username/spring-boot-app:${env.BUILD_NUMBER}"
                    sh """
                        docker build -t ${imageName} .
                        docker push ${imageName}
                    """
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                script {
                    // Example: Update image tag in Kubernetes manifest
                    sh "sed -i 's|image: .*|image: your-dockerhub-username/spring-boot-app:${env.BUILD_NUMBER}|' k8s/deployment.yaml"
                }
            }
        }

        stage('Deploy to Kubernetes via Helm/ArgoCD') {
            steps {
                script {
                    // Example for Helm upgrade
                    sh "helm upgrade spring-boot-app ./helm-chart -f ./helm-chart/values.yaml --install"
                }
            }
        }
    }
    post {
        always {
            cleanWs()  // Workspace cleanup
        }
    }
}
